<?xml version="1.0"?>
<Container version="2">
  <Name>Frigate-TensorRT</Name>
  <Repository>ghcr.io/blakeblackshear/frigate:0.18.0-tensorrt</Repository>
  <Registry>https://github.com/blakeblackshear/frigate/pkgs/container/frigate</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/blakeblackshear/frigate/issues</Support>
  <Project>https://frigate.video/</Project>
  <Overview>Frigate NVR 0.18.0 with TensorRT (Nvidia GPU hardware acceleration) and Google Coral TPU pass-through support.</Overview>
  <Category>MediaApp:Video Security:</Category>
  <WebUI>http://[IP]:[PORT:8971]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Hintab/docker_templates/main/frigate_template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/blakeblackshear/frigate/dev/docs/static/img/frigate.png</Icon>
  <ExtraParams>--shm-size=1g --gpus all</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires>Requires Nvidia Driver plugin installed in Unraid and Nvidia GPU available.</Requires>

  <!-- Ports -->
  <Config Name="Authenticated Web UI" Target="8971" Default="8971" Mode="tcp" Description="Authenticated UI and API access without TLS" Type="Port" Display="always" Required="true" Mask="false">8971</Config>
  <Config Name="Internal Web UI" Target="5000" Default="5000" Mode="tcp" Description="Internal unauthenticated UI and API access" Type="Port" Display="advanced" Required="false" Mask="false">5000</Config>
  <Config Name="RTSP Feed Port" Target="8554" Default="8554" Mode="tcp" Description="RTSP re-stream port" Type="Port" Display="always" Required="false" Mask="false">8554</Config>
  <Config Name="WebRTC TCP" Target="8555" Default="8555" Mode="tcp" Description="WebRTC TCP stream port" Type="Port" Display="advanced" Required="false" Mask="false">8555</Config>
  <Config Name="WebRTC UDP" Target="8555" Default="8555" Mode="udp" Description="WebRTC UDP stream port" Type="Port" Display="advanced" Required="false" Mask="false">8555</Config>

  <!-- Paths -->
  <Config Name="Appdata / Config" Target="/config" Default="/mnt/user/appdata/frigate" Mode="rw" Description="Location of frigate.yml configuration file and SQLite database." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frigate</Config>
  <Config Name="Media / Storage" Target="/media/frigate" Default="/mnt/user/appdata/frigate/media" Mode="rw" Description="Location for recordings, snapshots, and exports." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frigate/media</Config>
  <Config Name="RAM Cache" Target="/tmp/cache" Default="tmpfs" Mode="rw" Description="Tmpfs RAM cache for recording segments to reduce disk wear." Type="Path" Display="advanced" Required="false" Mask="false">tmpfs</Config>

  <!-- Environment Variables -->
  <Config Name="FRIGATE_RTSP_PASSWORD" Target="FRIGATE_RTSP_PASSWORD" Default="" Mode="" Description="RTSP stream authentication password" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="PLUS_API_KEY" Target="PLUS_API_KEY" Default="" Mode="" Description="Optional Frigate+ API key" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="NVIDIA_VISIBLE_DEVICES" Target="NVIDIA_VISIBLE_DEVICES" Default="all" Mode="" Description="Pass 'all' or your specific GPU UUID to container" Type="Variable" Display="always" Required="true" Mask="false">all</Config>
  <Config Name="NVIDIA_DRIVER_CAPABILITIES" Target="NVIDIA_DRIVER_CAPABILITIES" Default="all" Mode="" Description="Allows NVDEC/NVENC video decoding and CUDA acceleration" Type="Variable" Display="always" Required="true" Mask="false">all</Config>

  <!-- TensorRT Environment Variables -->
  <Config Name="YOLO_MODELS" Target="YOLO_MODELS" Default="yolov7-320" Mode="" Description="Specifies the YOLO model for TensorRT detection" Type="Variable" Display="always" Required="false" Mask="false">yolov7-320</Config>
  <Config Name="USE_FP16" Target="USE_FP16" Default="true" Mode="" Description="Set to true for GTX 16-series, RTX 20/30/40+ GPUs" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="TRT_MODEL_PREP_DEVICE" Target="TRT_MODEL_PREP_DEVICE" Default="0" Mode="" Description="GPU index for model preparation" Type="Variable" Display="always" Required="false" Mask="false">0</Config>

  <!-- Devices -->
  <Config Name="Google Coral TPU" Target="/dev/bus/usb" Default="/dev/bus/usb" Mode="" Description="USB bus path for Coral USB Accelerator (use /dev/apex_0 for PCIe)" Type="Device" Display="always" Required="false" Mask="false">/dev/bus/usb</Config>
</Container>
